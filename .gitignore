# ═══════════════════════════════════════════════════
# HExoskeleton .gitignore
# ═══════════════════════════════════════════════════

# ─── OS & IDE ─────────────────────────────────────
.DS_Store
Thumbs.db
.cursor/
.idea/
# .vscode/ — 팀 공유를 위해 추적 (개인 설정은 .vscode/*.code-workspace에 분리)
*.swp
*.swo

# ─── Python ───────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python testing & linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ─── Node.js ─────────────────────────────────────
node_modules/
.next/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Environment & Secrets ───────────────────────
.env
.env.local
.env.*.local
.env.mcp
*.pem
*.key
secrets/

# ─── HXSK ────────────────────────────────────────
# 기본: .hxsk/ 전체 무시, 아래 예외만 추적
.hxsk/*

# 루트 문서 (working docs + 메타)
!.hxsk/.bootstrap-version
!.hxsk/STATE.md
!.hxsk/PATTERNS.md
!.hxsk/SPEC.md
!.hxsk/ARCHITECTURE.md
!.hxsk/CHANGELOG.md
!.hxsk/DECISIONS.md
!.hxsk/ROADMAP.md
!.hxsk/STACK.md
!.hxsk/TODO.md
!.hxsk/VERIFICATION.md
!.hxsk/CURRENT.md
!.hxsk/JOURNAL.md

# 하위 디렉토리 (코어 구성요소)
!.hxsk/skills/
!.hxsk/agents/
!.hxsk/hooks/
!.hxsk/templates/
!.hxsk/examples/
!.hxsk/scripts/
!.hxsk/docs/
!.hxsk/prompts/
!.hxsk/research/
!.hxsk/issues/

# 이슈: MASTER/WORK는 런타임 생성 → 무시
.hxsk/issues/MASTER-*.md
.hxsk/issues/WORK-*.md
.hxsk/issues/archive/

# ─── Session & Logs ──────────────────────────────
.sessions/*.jsonl
*.log

# ─── Agent Memory (ephemeral) ────────────────────
.agent/memory.jsonl
**/memory.jsonl

# ─── Worktrees ───────────────────────────────────
.worktrees/
.claude/worktrees/

# ─── Database ────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
surreal.db/

# ─── Build Artifacts ─────────────────────────────
*.a
*.o
*.dll
*.dylib

# ─── Miscellaneous ───────────────────────────────
tmp/
temp/
*.tmp
*.bak
settings.local.json
