# ═══════════════════════════════════════════════════
# HExoskeleton .gitignore
# ═══════════════════════════════════════════════════

# ─── OS & IDE ─────────────────────────────────────
.DS_Store
Thumbs.db
.cursor/
.idea/
# .vscode/ — 팀 공유를 위해 추적 (개인 설정은 .vscode/*.code-workspace에 분리)
*.swp
*.swo

# ─── Python ───────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python testing & linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ─── Node.js ─────────────────────────────────────
node_modules/
.next/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Environment & Secrets ───────────────────────
.env
.env.local
.env.*.local
.env.mcp
*.pem
*.key
secrets/

# ─── HXSK (런타임/임시 데이터만 무시) ────────────
.hxsk/memories/
.hxsk/archive/
.hxsk/reports/
.hxsk/.modified-this-session
.hxsk/.session-active
.hxsk/context-config.yaml
.hxsk/prd-*.json
.hxsk/issues/MASTER-*.md
.hxsk/issues/WORK-*.md
.hxsk/issues/archive/

# ─── Session & Logs ──────────────────────────────
.sessions/*.jsonl
*.log

# ─── Agent Memory (ephemeral) ────────────────────
.agent/memory.jsonl
**/memory.jsonl

# ─── Claude Code Runtime (bootstrap.sh 자동 생성) ──
.claude/skills/
.claude/agents/
.claude/worktrees/

# ─── Worktrees ───────────────────────────────────
.worktrees/

# ─── Database ────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
surreal.db/

# ─── Build Artifacts ─────────────────────────────
*.a
*.o
*.dll
*.dylib

# ─── Miscellaneous ───────────────────────────────
tmp/
temp/
*.tmp
*.bak
settings.local.json
