{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsd.local/schemas/memory/base",
  "title": "GSD Memory Base Schema",
  "description": "A-Mem 확장 필드를 포함한 기본 메모리 스키마 (16개 타입)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "메모리 제목",
      "minLength": 1,
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "description": "검색 태그 (최소 2개 권장)",
      "items": { "type": "string" },
      "minItems": 1
    },
    "type": {
      "type": "string",
      "description": "메모리 타입 (16개 중 하나)",
      "enum": [
        "architecture-decision",
        "root-cause",
        "debug-eliminated",
        "debug-blocked",
        "health-event",
        "session-handoff",
        "execution-summary",
        "deviation",
        "pattern-discovery",
        "bootstrap",
        "session-summary",
        "session-snapshot",
        "security-finding",
        "lessons-learned",
        "term-definition",
        "general"
      ]
    },
    "created": {
      "type": "string",
      "description": "ISO-8601 생성 시각",
      "format": "date-time"
    },
    "contextual_description": {
      "type": "string",
      "description": "A-Mem: 1줄 요약 (검색 압축용)",
      "maxLength": 200
    },
    "keywords": {
      "type": "array",
      "description": "A-Mem: LLM 생성 검색 키워드",
      "items": { "type": "string" }
    },
    "related": {
      "type": "array",
      "description": "A-Mem Link: 관련 메모리 파일명",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "description": "ADR-007: GT 출처 메타데이터 (선택)",
      "properties": {
        "source":          { "type": "string" },
        "authority":       { "type": "string", "enum": ["high", "medium", "low"] },
        "derived_at":      { "type": "string", "format": "date" },
        "verified_at":     { "type": "string", "format": "date" },
        "contradicted_by": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    }
  },
  "required": ["title", "tags", "type", "created"],
  "additionalProperties": true
}
